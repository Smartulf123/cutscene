{
  "$comment": "Shared compiler settings. tsconfig.json builds the Node code, tsconfig.browser.json the code that runs inside a video, tsconfig.test.json checks the tests.",
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "newLine": "lf"
  }
}
