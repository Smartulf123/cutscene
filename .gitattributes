* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.mp4 binary
*.m4a binary
*.wav binary
*.webm binary
*.png binary
*.jpg binary
*.glb binary
*.ttf binary
*.woff2 binary

# Built from src/ by `npm run build` (the TypeScript source lives in src/)
tools/*.mjs linguist-generated
overlays/**/*.mjs linguist-generated
overlays/**/*.cjs linguist-generated
skills/cutscene/scripts/**/*.mjs linguist-generated
skills/cutscene-3d/scripts/**/*.mjs linguist-generated
skills/cutscene-3d/templates/tier1/*.js linguist-generated
skills/cutscene-edit/scripts/**/*.mjs linguist-generated
skills/cutscene-voice/scripts/**/*.mjs linguist-generated
# Declaration files the build writes next to each built file (the hand-written ones in src/ stay source)
*.d.mts linguist-generated
*.d.cts linguist-generated
*.d.ts linguist-generated
src/**/*.d.ts -linguist-generated

