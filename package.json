{
  "name": "cutscene",
  "version": "0.1.0",
  "private": true,
  "description": "Make and edit videos with your AI agent: HTML video compositions, Blender 3D and local AI voices.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:py": "python -m pytest tests",
    "check:build": "node tools/build.mjs --check",
    "check:pins": "node tools/check-pin-ages.mjs",
    "check:skills": "node tools/validate-skills.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
